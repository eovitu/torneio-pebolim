{
  "name": "@pebolim/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Regras de negócio puras do campeonato de pebolim (partida, gols, estatísticas, classificação, artilharia). Sem dependência de framework — única fonte de verdade do domínio.",
  "type": "module",
